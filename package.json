{
  "name": "jobview",
  "private": true,
  "version": "0.3.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "format": "prettier --write src docs fixtures *.json *.ts *.html *.md .github",
    "format:check": "prettier --check src docs fixtures *.json *.ts *.html *.md .github"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vitest": "^4.1.11"
  }
}
